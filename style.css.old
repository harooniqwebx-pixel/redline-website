:root {
  --red:#e32929;
  --black:#090909;
  --panel:#111111;
  --white:#f4f4f4;
  --muted:#999;
}

* { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior:smooth; }

body {
  background:var(--black);
  color:var(--white);
  font-family:'Inter',sans-serif;
  overflow-x:hidden;
}

a { color:inherit; text-decoration:none; }

.header {
  height:88px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 5.5%;
  background:#090909;
  border-bottom:1px solid #262626;
  position:relative;
  z-index:20;
}

.brand {
  font-family:'Barlow Condensed',sans-serif;
  font-size:36px;
  font-weight:900;
  letter-spacing:2px;
  line-height:.8;
}

.brand span { color:var(--red); }

.brand small {
  display:block;
  font-family:'Inter',sans-serif;
  font-size:8px;
  letter-spacing:3px;
  color:#888;
  margin-top:9px;
}

.navigation {
  display:flex;
  gap:21px;
  align-items:center;
}

.navigation a {
  font-size:9px;
  letter-spacing:1.2px;
  font-weight:700;
  color:#aaa;
  transition:.25s;
}

.navigation a:hover,.navigation a.active { color:var(--red); }

.header-cta {
  background:var(--red);
  padding:14px 18px;
  font-size:9px;
  font-weight:800;
  letter-spacing:1px;
  transition:.25s;
}

.header-cta:hover,.primary-button:hover { background:#b81818; }

.menu-toggle {
  display:none;
  color:white;
  background:none;
  border:0;
  font-size:25px;
  cursor:pointer;
}

.hero {
  min-height:690px;
  height:calc(100vh - 88px);
  max-height:950px;
  position:relative;
  display:flex;
  align-items:center;
  overflow:hidden;
  background:#111;
}

.hero-background {
  position:absolute;
  inset:0;
  background-size:cover;
  background-position:center 35%;
  filter:grayscale(65%) contrast(1.15) brightness(.63);
  transform:scale(1.02);
  animation:heroReveal 1.3s ease both;
}

.hero-shade {
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,#090909 0%,rgba(9,9,9,.94) 27%,rgba(9,9,9,.48) 61%,rgba(9,9,9,.15) 100%),
    linear-gradient(0deg,#090909 0%,transparent 30%,rgba(0,0,0,.2) 100%);
}

.hero-content {
  position:relative;
  z-index:2;
  padding:0 8%;
  max-width:900px;
  animation:contentIn .9s ease both;
}

.eyebrow {
  color:var(--red);
  font-size:10px;
  font-weight:800;
  letter-spacing:4px;
  margin-bottom:25px;
}

.red-dot {
  display:inline-block;
  width:7px;
  height:7px;
  background:var(--red);
  border-radius:50%;
  margin-right:10px;
}

.hero h1 {
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(75px,10vw,145px);
  font-weight:900;
  line-height:.79;
  letter-spacing:-2px;
  text-transform:uppercase;
}

.hero h1 span,.intro-layout h2 span,.statement h2 span {
  color:var(--red);
}

.hero-content > p {
  max-width:480px;
  font-size:14px;
  line-height:1.9;
  color:#bbb;
  margin:32px 0;
}

.primary-button {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:var(--red);
  color:white;
  padding:17px 24px;
  font-size:10px;
  font-weight:800;
  letter-spacing:1.4px;
  border:0;
  cursor:pointer;
  transition:.25s;
}

.hero-bottom {
  margin-top:100px;
  font-size:9px;
  letter-spacing:3px;
  color:#777;
}

.hero-side-label {
  position:absolute;
  right:35px;
  top:40%;
  writing-mode:vertical-rl;
  font-size:9px;
  letter-spacing:4px;
  color:#aaa;
}

.hero-index {
  position:absolute;
  bottom:30px;
  right:6%;
  font-family:'Barlow Condensed',sans-serif;
  font-size:32px;
  font-weight:800;
}

.hero-index span { color:#777; font-size:17px; }

.intro-section { padding:110px 8%; }

.section-tag {
  color:var(--red);
  font-size:10px;
  letter-spacing:3px;
  font-weight:800;
  margin-bottom:35px;
}

.intro-layout {
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:40px;
  margin-bottom:65px;
}

.intro-layout h2 {
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(48px,7vw,90px);
  line-height:.92;
  font-weight:900;
  max-width:650px;
}

.intro-layout > p {
  max-width:370px;
  color:var(--muted);
  font-size:13px;
  line-height:2;
}

.feature-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.feature-card {
  min-height:390px;
  position:relative;
  overflow:hidden;
  background:#171717;
  display:flex;
  align-items:flex-end;
  padding:28px;
  border:1px solid #292929;
  transition:transform .35s,border-color .35s;
}

.feature-card:hover {
  transform:translateY(-7px);
  border-color:var(--red);
}

.feature-image {
  position:absolute;
  inset:0;
  background-size:cover;
  background-position:center;
  filter:grayscale(70%) brightness(.48);
  transition:transform .5s;
}

.feature-card:hover .feature-image { transform:scale(1.07); }

.feature-card::after {
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(0deg,#090909 0%,transparent 100%);
}

.card-number,.feature-info { position:relative; z-index:2; }

.card-number {
  position:absolute;
  top:22px;
  left:25px;
  color:var(--red);
  font-size:12px;
  letter-spacing:3px;
}

.feature-info h3,.info-card h3,.price-card h3 {
  font-family:'Barlow Condensed',sans-serif;
  font-size:38px;
  font-weight:800;
}

.feature-info p,.info-card p,.price-card p {
  color:#aaa;
  font-size:12px;
  line-height:1.8;
  margin:12px 0 20px;
}

.arrow,.text-link {
  font-size:9px;
  font-weight:800;
  letter-spacing:2px;
  color:var(--red);
}

.info-card,.price-card {
  background:var(--panel);
  border:1px solid #292929;
  padding:35px;
  min-height:220px;
}

.info-card .eyebrow,.price-card .eyebrow { margin-bottom:20px; }

.schedule { border-top:1px solid #292929; }

.schedule-row {
  display:grid;
  grid-template-columns:1fr 2fr 1fr;
  gap:20px;
  padding:24px;
  border-bottom:1px solid #292929;
  font-size:12px;
}

.schedule-row strong { color:var(--red); letter-spacing:2px; }
.schedule-row span:last-child { text-align:right; color:#aaa; }

.price-card .price {
  font-size:14px;
  color:var(--red);
  margin:30px 0;
  font-weight:800;
}

.gallery-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  grid-auto-rows:240px;
  gap:15px;
}

.gallery-image { overflow:hidden; background:#171717; }
.gallery-image img {
  width:100%;
  height:100%;
  object-fit:cover;
  filter:grayscale(65%);
  transition:.4s;
}
.gallery-image:hover img { transform:scale(1.05); filter:grayscale(0); }
.gallery-2,.gallery-5 { grid-row:span 2; }

.contact-form {
  max-width:700px;
  display:grid;
  gap:20px;
}

.contact-form label {
  display:grid;
  gap:10px;
  color:#aaa;
  font-size:11px;
  letter-spacing:1px;
}

.contact-form input,.contact-form textarea,.contact-form select {
  background:#151515;
  border:1px solid #333;
  padding:16px;
  color:white;
  font:inherit;
  outline:none;
}

.contact-form input:focus,.contact-form textarea:focus,.contact-form select:focus {
  border-color:var(--red);
}

.contact-form button { justify-self:start; }
.form-status { color:var(--red); font-size:12px; }

.statement {
  padding:100px 8%;
  background:#111;
  text-align:center;
  border-top:1px solid #292929;
}

.statement > span {
  font-size:10px;
  color:var(--red);
  letter-spacing:4px;
}

.statement h2 {
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(45px,7vw,90px);
  line-height:1;
  margin:25px 0 35px;
}

.footer {
  padding:65px 8% 25px;
  display:grid;
  grid-template-columns:1fr 2fr;
  gap:40px;
  background:#080808;
}

.footer > div:first-child > p {
  font-size:11px;
  color:#777;
  margin-top:25px;
}

.footer-links {
  display:flex;
  flex-wrap:wrap;
  gap:20px;
  align-content:start;
}

.footer-links a {
  font-size:9px;
  color:#aaa;
  letter-spacing:1px;
}

.footer-links a:hover { color:var(--red); }

.copyright {
  grid-column:1/-1;
  border-top:1px solid #252525;
  padding-top:25px;
  color:#666;
  font-size:9px;
  letter-spacing:2px;
}

.reveal {
  opacity:0;
  transform:translateY(25px);
  transition:opacity .7s,transform .7s;
}
.reveal.visible { opacity:1; transform:translateY(0); }

@keyframes contentIn {
  from {opacity:0;transform:translateY(25px)}
  to {opacity:1;transform:translateY(0)}
}

@keyframes heroReveal {
  from {transform:scale(1.08);opacity:.5}
  to {transform:scale(1.02);opacity:1}
}

@media(max-width:1100px) {
  .navigation { gap:12px; }
  .navigation a { font-size:8px; }
  .header-cta { display:none; }
}

@media(max-width:760px) {
  .header { height:75px; padding:0 6%; }
  .menu-toggle { display:block; }
  .navigation {
    display:none;
    position:absolute;
    top:75px;
    left:0;
    width:100%;
    background:#101010;
    padding:25px;
    flex-direction:column;
    align-items:stretch;
    gap:0;
    border-bottom:1px solid #333;
  }
  .navigation.open { display:flex; }
  .navigation a { padding:14px 5px; font-size:11px; }
  .hero { min-height:720px; height:calc(100vh - 75px); }
  .hero-background { background-position:60% center; }
  .hero-shade {
    background:linear-gradient(90deg,rgba(9,9,9,.92),rgba(9,9,9,.42)),
    linear-gradient(0deg,#090909,transparent 60%);
  }
  .hero-content { padding:0 7%; }
  .hero h1 { font-size:clamp(65px,14vw,105px); }
  .hero-content > p { max-width:330px; font-size:12px; }
  .hero-bottom { margin-top:70px; font-size:8px; }
  .hero-side-label { display:none; }
  .intro-section { padding:75px 7%; }
  .intro-layout { display:block; }
  .intro-layout > p { margin-top:25px; }
  .feature-grid { grid-template-columns:1fr; }
  .feature-card { min-height:350px; }
  .gallery-grid { grid-template-columns:repeat(2,1fr); grid-auto-rows:180px; }
  .schedule-row { grid-template-columns:1fr 1.5fr; }
  .schedule-row span:last-child { grid-column:2; text-align:left; }
  .footer { grid-template-columns:1fr; }
  .copyright { grid-column:1; }
}

@media(prefers-reduced-motion:reduce) {
  *,*::before,*::after {
    animation-duration:.01ms!important;
    transition-duration:.01ms!important;
    scroll-behavior:auto!important;
  }
  .reveal { opacity:1; transform:none; }
}


/* REDLINE PREMIUM NAVIGATION AND BUTTON UPDATE */

.header {
  padding-left: 4%;
  padding-right: 4%;
  gap: 22px;
}

.navigation {
  gap: 9px;
}

.navigation a {
  padding: 11px 13px;
  border: 1px solid transparent;
  border-radius: 4px;
  transition: .25s ease;
  white-space: nowrap;
}

.navigation a:hover,
.navigation a.active {
  color: #fff;
  background: #191919;
  border-color: #383838;
}

.navigation a.active {
  border-bottom: 2px solid var(--red);
}

.header-cta {
  border-radius: 4px;
  padding: 13px 17px;
  white-space: nowrap;
  letter-spacing: 1.2px;
}

.primary-button {
  border-radius: 4px;
  padding: 14px 20px;
  min-height: 44px;
  letter-spacing: 1.5px;
  transition: background .25s ease, transform .25s ease;
}

.primary-button:hover {
  transform: translateY(-2px);
}

.feature-card {
  border-radius: 5px;
}

.info-card,
.price-card {
  border-radius: 5px;
}

.contact-form input,
.contact-form textarea,
.contact-form select {
  border-radius: 4px;
}

.hero-background {
  background-position: center 25%;
}

.hero-shade {
  background:
    linear-gradient(90deg, #090909 0%, rgba(9,9,9,.90) 28%, rgba(9,9,9,.40) 68%, rgba(9,9,9,.15) 100%),
    linear-gradient(0deg, #090909 0%, transparent 35%),
    linear-gradient(120deg, rgba(130,0,0,.20), transparent 65%);
}

@media(max-width:1100px) {
  .navigation { gap: 5px; }
  .navigation a { padding: 9px 8px; }
}

@media(max-width:760px) {
  .navigation a {
    border-radius: 3px;
    padding: 14px;
  }

  .header-cta {
    display: none;
  }
}


/* REDLINE HYBRID PARALLAX EXPERIENCE */

.hero {
  overflow: hidden;
  isolation: isolate;
}

.hero-background {
  will-change: transform;
  transform: scale(1.06);
}

.redline-3d-canvas {
  display: block;
}

.hero-content {
  will-change: transform;
}

/* STACKING TRAINING CARDS */

.feature-grid {
  display: block;
  position: relative;
  padding: 35px 0 12vh;
}

.feature-card {
  position: sticky;
  top: 105px;
  width: min(100%, 1000px);
  margin: 0 auto 22vh;
  transform-origin: center top;
  will-change: transform, opacity;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.45);
}

.feature-card:last-child {
  margin-bottom: 0;
}

/* SCROLL DEPTH */

.intro-layout,
.statement,
.section-tag {
  will-change: transform, opacity;
}

@media (max-width: 700px) {
  .feature-grid {
    padding-top: 20px;
  }

  .feature-card {
    top: 85px;
    width: 100%;
    margin-bottom: 14vh;
  }

  .redline-3d-canvas {
    opacity: 0.65;
  }

  .hero-background {
    background-position: 65% center;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-background,
  .hero-content,
  .feature-card {
    will-change: auto;
  }
}

/* ===== REDLINE HYBRID CINEMATIC EXPERIENCE ===== */

#redline-three-canvas {
  display: block;
  mix-blend-mode: screen;
}

.hero-background {
  will-change: transform;
  transform: scale(1.06);
}

.hero-content {
  will-change: transform;
}

/* IMAGE STACKING CARDS */

.feature-grid {
  display: flex;
  flex-direction: column;
  gap: 12vh;
  padding: 40px 0 15vh;
  position: relative;
}

.feature-card {
  position: sticky !important;
  top: 100px;
  width: min(100%, 1050px);
  min-height: 430px;
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 5px;
  background: #111;
  transform-origin: center top;
  box-shadow: 0 30px 100px rgba(0,0,0,.65);
  will-change: transform, opacity;
}

/* Actual photographs */
.feature-card-photo {
  display: block;
  width: 100%;
  height: 270px;
  object-fit: cover;
  object-position: center 35%;
  filter: brightness(.75) contrast(1.12);
  transition: filter .5s ease;
}

.feature-card:hover .feature-card-photo {
  filter: brightness(.95) contrast(1.12);
}

/* Card content */
.feature-card > *:not(.feature-card-photo) {
  position: relative;
  z-index: 2;
}

.feature-card {
  padding-bottom: 28px;
}

.feature-card h2,
.feature-card h3 {
  color: #fff;
  margin: 22px 28px 12px;
}

.feature-card p {
  color: #aaa;
  margin: 0 28px 20px;
  line-height: 1.8;
}

.feature-card a {
  margin-left: 28px;
}

/* Red cinematic details */
.feature-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 270px;
  pointer-events: none;
  background: linear-gradient(
    0deg,
    rgba(10,10,10,.7),
    transparent 65%
  );
}

@media(max-width:700px) {
  .feature-grid {
    gap: 10vh;
    padding-bottom: 12vh;
  }

  .feature-card {
    top: 85px;
    min-height: 350px;
  }

  .feature-card-photo {
    height: 220px;
  }

  .feature-card::after {
    height: 220px;
  }

  #redline-three-canvas {
    opacity: .8;
  }
}

/* REDLINE VISUAL CLEANUP */

#redline-three-canvas,
.redline-3d-canvas {
  display: none !important;
}

/* Navigation follows the page */
.header {
  position: sticky !important;
  top: 0 !important;
  z-index: 99999 !important;
  width: 100%;
  background: rgba(8, 8, 8, 0.96) !important;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* Stop unwanted orbital decorations */

/* BRIGHTER REDLINE HERO */
.hero-background {
  opacity: 1 !important;
  filter: brightness(1.55) contrast(1.12) !important;
}

.hero-shade {
  opacity: 0.55 !important;
}

/* KEEP NAVIGATION VISIBLE */
.header {
  position: sticky !important;
  top: 0 !important;
  z-index: 99999 !important;
}

/* REDLINE FULL SCROLL EXPERIENCE */

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

.header {
  position: sticky !important;
  top: 0;
  z-index: 99999 !important;
}

.redline-scroll-section {
  min-height: 680px;
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 100px 8%;
  background: #111;
  border-bottom: 1px solid #292929;
}

.redline-section-image {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.redline-section-image img {
  width: 100%;
  height: 120%;
  object-fit: cover;
  object-position: center 35%;
  filter: brightness(.85) contrast(1.1);
  will-change: transform;
}

.redline-section-image::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0,0,0,.94),
    rgba(0,0,0,.48),
    rgba(0,0,0,.12)
  );
}

.redline-section-content {
  position: relative;
  z-index: 2;
  max-width: 650px;
}

.redline-section-content span {
  color: #ff2638;
  letter-spacing: 4px;
  font-size: 11px;
  font-weight: 800;
}

.redline-section-content h2 {
  font-size: clamp(55px, 9vw, 110px);
  line-height: .95;
  margin: 25px 0;
  color: white;
}

.redline-section-content p {
  color: #ddd;
  line-height: 1.9;
  max-width: 480px;
}

.redline-scroll-section {
  scroll-margin-top: 90px;
}

@media(max-width:700px) {
  .redline-scroll-section {
    min-height: 560px;
    padding: 75px 7%;
  }
}
